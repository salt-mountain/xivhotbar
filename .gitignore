# --- Windower 4 addon: runtime-generated files ---
# Generated on first login from defaults.lua; per-user, never commit
data/settings.xml

# Per-character hotbar layouts created by users of the addon.
# Bundled example/template folders are explicitly re-included below.
data/*/
!data/examples/

# --- Local workspace ---
scratch/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor files ---
*.swp
*.swo
*~
.vscode/
.idea/

# --- Misc ---
*.log
*.bak
*.tmp
